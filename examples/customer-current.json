{
  "schema_version": "1.0",
  "project": {
    "name": "Customer Group-Based Latch-Up Project"
  },
  "mappings": {
    "group_type_prefix": {
      "INPUT": "IN",
      "OUTPUT": "O",
      "IO": "IO",
      "POWER": "SU",
      "GROUND": "GND"
    }
  },
  "formatters": {
    "voltage_token": {
      "type": "decimal_token",
      "separator": "V",
      "decimal_places": 1
    }
  },
  "sources": {
    "customer_pins": {
      "type": "json",
      "path": "./data/customer-device.json",
      "select": "$.pins[*]",
      "mapping": {
        "designator": "pin_number",
        "name": "signal_name",
        "parameters.pin_type": "latch_up_type",
        "parameters.v_max": "v_max",
        "parameters.v_min": "v_min"
      }
    }
  },
  "dut": {
    "name": "Customer DUT",
    "pins": {
      "source": "customer_pins"
    }
  },
  "groups": {
    "generation": [
      {
        "id": "groups_by_type_and_voltage",
        "select": {
          "where": {
            "parameters.pin_type": {
              "in": [
                "INPUT",
                "OUTPUT",
                "IO",
                "POWER"
              ]
            }
          }
        },
        "group_by": [
          "parameters.pin_type",
          "parameters.v_max",
          "parameters.v_min"
        ],
        "set": {
          "group_type": {
            "from": "partition.parameters.pin_type"
          },
          "parameters.v_max": {
            "from": "partition.parameters.v_max"
          },
          "parameters.v_min": {
            "from": "partition.parameters.v_min"
          }
        },
        "name": {
          "template": "{prefix}{voltage}",
          "fields": {
            "prefix": {
              "source": "partition.parameters.pin_type",
              "mapping": "group_type_prefix"
            },
            "voltage": {
              "source": "partition.parameters.v_max",
              "formatter": "voltage_token"
            }
          }
        }
      }
    ]
  },
  "power_resources": {
    "DC1": {
      "role": "STRESS"
    },
    "DC2": {
      "role": "BIAS"
    },
    "DC3": {
      "role": "BIAS"
    },
    "DC4": {
      "role": "BIAS"
    }
  },
  "device_states": {
    "logic_low": {
      "allocation": {
        "mode": "hybrid",
        "strategy": "voltage_first",
        "reserve": [
          "DC1"
        ],
        "ganging_policy": "same_voltage"
      },
      "rules": [
        {
          "when": {
            "group.group_type": {
              "in": [
                "INPUT",
                "OUTPUT",
                "IO"
              ]
            }
          },
          "set": {
            "assignment": "GROUND",
            "bias": {
              "mode": "GROUND"
            }
          }
        }
      ]
    },
    "logic_high": {
      "allocation": {
        "mode": "hybrid",
        "strategy": "voltage_first",
        "reserve": [
          "DC1"
        ],
        "ganging_policy": "same_voltage"
      },
      "rules": [
        {
          "when": {
            "group.group_type": {
              "in": [
                "INPUT",
                "OUTPUT",
                "IO"
              ]
            }
          },
          "set": {
            "bias": {
              "mode": "VOLTAGE",
              "level": {
                "from": "group.v_max"
              }
            }
          }
        }
      ]
    }
  },
  "test_plan_generation": {
    "rules": [
      {
        "id": "signal_tests",
        "groups": {
          "select": {
            "where": {
              "group_type": {
                "in": [
                  "INPUT",
                  "OUTPUT",
                  "IO"
                ]
              }
            }
          },
          "partition": {
            "mode": "each"
          }
        },
        "dimensions": [
          {
            "name": "logic_level",
            "values": [
              {
                "value": "LOW",
                "set": {
                  "device_state": "logic_low",
                  "stress_parameters.hold_time": 0.05
                }
              },
              {
                "value": "HIGH",
                "set": {
                  "device_state": "logic_high",
                  "stress_parameters.hold_time": 0.1
                }
              }
            ]
          },
          {
            "name": "polarity",
            "values": [
              {
                "value": "POSITIVE",
                "set": {
                  "stress_parameters.stress_voltage": {
                    "from": "group.v_max",
                    "add": [
                      0.0,
                      0.5,
                      1.0,
                      1.5
                    ]
                  }
                }
              },
              {
                "value": "NEGATIVE",
                "set": {
                  "stress_parameters.stress_voltage": {
                    "from": "group.v_min",
                    "add": [
                      0.0,
                      -0.5,
                      -1.0,
                      -1.5
                    ]
                  }
                }
              }
            ]
          }
        ],
        "template": {
          "test_type": "SIGNAL",
          "name": {
            "template": "{group.name}_{logic_level}_{polarity}"
          },
          "stress_parameters": {
            "compliance": 0.1,
            "hold_time": 0.1
          }
        },
        "overrides": [
          {
            "scope": "plan",
            "when": {
              "logic_level": "HIGH",
              "polarity": "NEGATIVE"
            },
            "set": {
              "stress_parameters.hold_time": 0.075
            }
          },
          {
            "scope": "group",
            "when": {
              "group.group_type": "OUTPUT",
              "polarity": "NEGATIVE"
            },
            "set": {
              "stress_parameters.compliance": 0.025
            }
          }
        ]
      }
    ]
  }
}
