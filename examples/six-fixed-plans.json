{
  "schema_version": "1.0",
  "project": {
    "name": "Six Fixed Plans Example"
  },
  "groups": {
    "external": true
  },
  "device_states": {
    "signal_low": {},
    "signal_high": {},
    "supply_positive": {},
    "supply_negative": {}
  },
  "test_plan_generation": {
    "rules": [
      {
        "id": "four_signal_plans",
        "groups": {
          "select": {
            "where": {
              "group_type": {
                "in": ["INPUT", "OUTPUT", "IO"]
              }
            }
          },
          "partition": {
            "mode": "all"
          }
        },
        "dimensions": [
          {
            "name": "logic_level",
            "values": [
              {
                "value": "LOW",
                "set": {
                  "device_state": "signal_low"
                }
              },
              {
                "value": "HIGH",
                "set": {
                  "device_state": "signal_high"
                }
              }
            ]
          },
          {
            "name": "polarity",
            "values": ["POSITIVE", "NEGATIVE"]
          }
        ],
        "template": {
          "test_type": "SIGNAL",
          "name": {
            "template": "ALL_SIGNALS_{logic_level}_{polarity}"
          },
          "stress_parameters": {
            "stress_voltage": {
              "values": [1.0, 2.0, 3.0]
            },
            "compliance": 0.1,
            "hold_time": 0.1
          }
        }
      },
      {
        "id": "two_supply_plans",
        "groups": {
          "select": {
            "where": {
              "group_type": "POWER"
            }
          },
          "partition": {
            "mode": "all"
          }
        },
        "dimensions": [
          {
            "name": "polarity",
            "values": [
              {
                "value": "POSITIVE",
                "set": {
                  "device_state": "supply_positive",
                  "stress_parameters.stress_voltage": {
                    "from": "group.v_max",
                    "factor_range": {
                      "start": 1.0,
                      "stop": 1.3,
                      "step": 0.1
                    }
                  }
                }
              },
              {
                "value": "NEGATIVE",
                "set": {
                  "device_state": "supply_negative",
                  "stress_parameters.stress_voltage": {
                    "from": "group.v_min",
                    "offset_range": {
                      "start": 0.0,
                      "stop": -1.5,
                      "step": -0.5
                    }
                  }
                }
              }
            ]
          }
        ],
        "template": {
          "test_type": "SUPPLY",
          "name": {
            "template": "ALL_SUPPLIES_{polarity}"
          },
          "stress_parameters": {
            "compliance": 0.2,
            "hold_time": 0.1
          }
        }
      }
    ]
  }
}
