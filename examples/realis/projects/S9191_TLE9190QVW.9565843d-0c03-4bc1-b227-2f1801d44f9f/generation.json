  "test_plan_generation": {
    "rules": [
      {
        "id": "signal_tests",
        "groups": {
          "select": {
            "where": {
              "group_type": {
                "in": [
                  "INPUT",
                  "OUTPUT",
                  "IO"
                ]
              }
            }
          },
          "partition": {
            "mode": "each"
          }
        },
        "dimensions": [
          {
            "name": "logic_level",
            "values": [
              {
                "value": "LOW",
                "set": {
                  "device_state": "logic_low"
                }
              },
              {
                "value": "HIGH",
                "set": {
                  "device_state": "logic_high"
                }
              }
            ]
          },
          {
            "name": "polarity",
            "values": [
              {
                "value": "POSITIVE",
                "set": {
                  "stress_parameters.peak": {
                    "from": "group.clamp_voltage_max",
                    "multiply_by": [
                      1.0
                    ]
                  }
                }
              },
              {
                "value": "NEGATIVE",
                "set": {
                  "stress_parameters.peak": {
                    "from": "group.clamp_voltage_min",
                    "multiply_by": [
                      1.0
                    ]
                  }
                }
              }
            ]
          }
        ],
        "template": {
          "test_type": "SIGNAL",
          "name": {
            "template": "LU_{group.name}_{polarity}_{logic_level}"
          },
          "stress_parameters": {
            "source_mode": "voltage",
            "base": 0.0,
            "compliance": 0.15,
            "pulse_width": 0.01
          }
        }
      },
      {
        "id": "supply_tests",
        "groups": {
          "select": {
            "where": {
              "group_type": "POWER"
            }
          },
          "partition": {
            "mode": "each"
          }
        },
        "dimensions": [
          {
            "name": "logic_level",
            "values": [
              {
                "value": "LOW",
                "set": {
                  "device_state": "logic_low"
                }
              },
              {
                "value": "HIGH",
                "set": {
                  "device_state": "logic_high"
                }
              }
            ]
          }
        ],
        "template": {
          "test_type": "SUPPLY",
          "name": {
            "template": "LU_{group.name}_SUPPLY_{logic_level}"
          },
          "stress_parameters": {
            "source_mode": "voltage",
            "base": 0.0,
            "peak": {
              "from": "group.v_max",
              "multiply_by": [
                1.0,
                1.5
              ]
            },
            "compliance": 0.2,
            "pulse_width": 0.01
          }
        }
      }
    ]
